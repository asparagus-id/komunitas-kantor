{
  "build": {
    "distDir": "../public",
    "devPath": "../public",
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "CCTV Backup Agent",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "scope": [
          "https://sda-octopus-bot.edw-yoga2.workers.dev/*",
          "https://gus-asisten.rempahecho.workers.dev/*",
          "http://192.168.*.*/*",
          "http://10.*.*.*/*"
        ]
      },
      "window": {
        "all": false,
        "close": true,
        "minimize": true,
        "show": true,
        "hide": true,
        "setFocus": true
      }
    },
    "systemTray": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis", "updater"],
      "identifier": "com.rempahecho.cctvbackupagent",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/asparagus-id/komunitas-kantor/releases/latest/download/latest-cctv-agent.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3OUQ0NEQxRDc0REZDNjMKUldSai9FM1gwVVNkbC91bnNZTzhyN0FhS1ZjMmd6SkN4TldDUG5VTHRicm1TV1Q4M21Pay9YNjMK"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "CCTV Backup Agent",
        "width": 420,
        "height": 340,
        "resizable": false,
        "fullscreen": false,
        "fileDropEnabled": false,
        "visible": true,
        "url": "index.html"
      }
    ]
  }
}
